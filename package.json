{
  "name": "ornikar-test",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react/jsx-pascal-case": "off"
    }
  },
  "dependencies": {
    "@babel/core": "7.22.5",
    "@ornikar/bumper": "6.4.1",
    "@ornikar/gt-standard-font": "6.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.4.10",
    "@react-native/metro-config": "0.87.1",
    "axios": "1.4.0",
    "expo": "56.0.19",
    "expo-linear-gradient": "56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intl": "10.1.4",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "4.6.3",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "react-scripts": "5.0.1",
    "styled-components": "6.0.1"
  },
  "devDependencies": {
    "@ornikar/browserslist-config": "5.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "check-package-dependencies": "7.2.0",
    "eslint": "8.43.0",
    "eslint-config-react-app": "7.0.1",
    "prettier": "2.8.8",
    "react-native-web": "0.21.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "lint": "eslint src"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all",
    "extends @ornikar/browserslist-config"
  ],
  "packageManager": "yarn@3.1.1"
}
